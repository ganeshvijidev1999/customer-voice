# OPENROUTER_API_KEY: Server-side OpenRouter AI API key (never exposed to browser).
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="google/gemini-2.5-flash"

# SUPABASE CONFIGURATION (Optional — when configured, backend connects to your Supabase PostgreSQL project;
# when omitted, the app runs seamlessly on a persistent local SQLite database mirroring the exact 10-table schema).
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-publishable-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Optional browser-safe Supabase variables (Publishable/Anon key ONLY — never service_role)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-publishable-anon-key"

# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"
